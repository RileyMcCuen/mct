---
const currentYear = new Date().getFullYear();
---

<footer class="bg-navy text-cream">
  <div class="max-w-6xl mx-auto px-4 py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- Company info -->
      <div>
        <div class="flex items-center gap-3 mb-4">
          <img src={`${import.meta.env.BASE_URL}images/logo.jpg`} alt="McCuen Construction & Trucking logo" class="w-10 h-10 rounded" />
          <div>
            <div class="text-lg font-bold leading-tight">McCuen Construction</div>
            <div class="text-xs text-steel-light tracking-wider uppercase">& Trucking</div>
          </div>
        </div>
        <p class="text-steel-light text-sm leading-relaxed">
          Dependable trucking and construction services in Billings, Montana.
          From gravel hauling to excavation, we get the job done right.
        </p>
      </div>

      <!-- Quick links -->
      <div>
        <h3 class="text-accent font-semibold uppercase text-sm tracking-wider mb-4">Quick Links</h3>
        <ul class="space-y-2">
          <li><a href="/" class="text-steel-light hover:text-brand transition-colors text-sm">Home</a></li>
          <li><a href="/services" class="text-steel-light hover:text-brand transition-colors text-sm">Services</a></li>
          <li><a href="/about" class="text-steel-light hover:text-brand transition-colors text-sm">About Us</a></li>
          <li><a href="/gallery" class="text-steel-light hover:text-brand transition-colors text-sm">Gallery</a></li>
          <li><a href="/contact" class="text-steel-light hover:text-brand transition-colors text-sm">Contact</a></li>
        </ul>
      </div>

      <!-- Contact info -->
      <div>
        <h3 class="text-accent font-semibold uppercase text-sm tracking-wider mb-4">Contact Us</h3>
        <ul class="space-y-3 text-sm">
          <li class="flex items-start gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-accent shrink-0 mt-0.5" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd" />
            </svg>
            <a href="https://maps.google.com/?q=1212+Bench+Blvd+Billings+MT+59105" target="_blank" rel="noopener" class="text-steel-light hover:text-brand transition-colors">
              1212 Bench Blvd<br>Billings, MT 59105
            </a>
          </li>
          <li class="flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-accent shrink-0" viewBox="0 0 20 20" fill="currentColor">
              <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z" />
            </svg>
            <a href="tel:+14069452426" class="text-steel-light hover:text-brand transition-colors">(406) 945-2426</a>
          </li>
          <li class="flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-accent shrink-0" viewBox="0 0 20 20" fill="currentColor">
              <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z" />
              <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z" />
            </svg>
            <a href="mailto:office@mccuenconstructiontrucking.com" class="text-steel-light hover:text-brand transition-colors">office@mccuenconstructiontrucking.com</a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="border-t border-steel-dark mt-8 pt-6 flex flex-col md:flex-row justify-between items-center gap-3 text-xs text-steel">
      <p>&copy; {currentYear} McCuen Construction & Trucking Inc. All rights reserved.</p>
      <p>USDOT #3684397 &bull; MC #1282815 &bull; Fully Insured</p>
    </div>
  </div>
</footer>
