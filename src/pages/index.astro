---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="McCuen Construction & Trucking | Gravel Hauling & Excavation | Billings, MT"
  description="McCuen Construction & Trucking provides dependable gravel hauling, excavation, and site work services in Billings, Montana and surrounding areas. Family-owned, fully insured, DOT certified."
>
  <!-- Hero Section -->
  <section class="relative bg-navy text-cream overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-navy via-navy-light to-navy opacity-90"></div>
    <!-- Diagonal accent -->
    <div class="absolute bottom-0 left-0 right-0 h-20 bg-cream" style="clip-path: polygon(0 100%, 100% 100%, 100% 0);"></div>
    <div class="relative max-w-6xl mx-auto px-4 py-24 md:py-32">
      <div class="max-w-2xl">
        <p class="text-accent uppercase tracking-widest text-sm font-semibold mb-4">Billings, Montana</p>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold leading-tight mb-6">
          Hauling &amp; Excavation<br>
          <span class="text-brand">Done Right.</span>
        </h1>
        <p class="text-lg md:text-xl text-steel-light leading-relaxed mb-8 max-w-xl">
          From gravel and aggregate hauling to excavation and site prep, McCuen Construction & Trucking delivers dependable service across Yellowstone County and beyond.
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a href="tel:+14069452426" class="inline-flex items-center justify-center gap-2 bg-brand text-white px-6 py-3 rounded font-bold text-lg hover:bg-brand-light transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
              <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z" />
            </svg>
            (406) 945-2426
          </a>
          <a href={`${import.meta.env.BASE_URL}/contact`} class="inline-flex items-center justify-center gap-2 border-2 border-cream text-cream px-6 py-3 rounded font-bold text-lg hover:bg-cream hover:text-navy transition-colors">
            Request a Quote
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Services Overview -->
  <section class="py-16 md:py-24">
    <div class="max-w-6xl mx-auto px-4">
      <div class="text-center mb-12">
        <p class="text-brand uppercase tracking-widest text-sm font-semibold mb-2">What We Do</p>
        <h2 class="text-3xl md:text-4xl font-bold">Our Services</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <!-- Gravel Hauling -->
        <div class="bg-white rounded-lg shadow-md p-6 border-t-4 border-accent hover:shadow-lg transition-shadow">
          <div class="w-12 h-12 bg-accent/10 rounded-lg flex items-center justify-center mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-brand" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10l2-1 2 1 2-1 2 1zm6 0V6a1 1 0 00-1-1h-2a1 1 0 00-1 1v10l2-1 2 1z" />
            </svg>
          </div>
          <h3 class="text-lg font-bold mb-2">Gravel Hauling</h3>
          <p class="text-steel text-sm leading-relaxed">Large quantity aggregate and gravel hauling with side dump trucks. We move big loads efficiently.</p>
        </div>

        <!-- Excavation -->
        <div class="bg-white rounded-lg shadow-md p-6 border-t-4 border-accent hover:shadow-lg transition-shadow">
          <div class="w-12 h-12 bg-accent/10 rounded-lg flex items-center justify-center mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-brand" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
            </svg>
          </div>
          <h3 class="text-lg font-bold mb-2">Excavation & Site Work</h3>
          <p class="text-steel text-sm leading-relaxed">Site preparation, grading, and excavation for residential and commercial construction projects.</p>
        </div>

        <!-- Material Transport -->
        <div class="bg-white rounded-lg shadow-md p-6 border-t-4 border-accent hover:shadow-lg transition-shadow">
          <div class="w-12 h-12 bg-accent/10 rounded-lg flex items-center justify-center mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-brand" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" />
            </svg>
          </div>
          <h3 class="text-lg font-bold mb-2">Material Transport</h3>
          <p class="text-steel text-sm leading-relaxed">Building materials, heavy machinery, farm supplies &mdash; we haul what your project needs.</p>
        </div>

        <!-- General Freight -->
        <div class="bg-white rounded-lg shadow-md p-6 border-t-4 border-accent hover:shadow-lg transition-shadow">
          <div class="w-12 h-12 bg-accent/10 rounded-lg flex items-center justify-center mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-brand" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 17a2 2 0 11-4 0 2 2 0 014 0zM19 17a2 2 0 11-4 0 2 2 0 014 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10h10zm0 0h6a1 1 0 001-1v-4a1 1 0 00-.293-.707l-3-3A1 1 0 0016 7h-3v9z" />
            </svg>
          </div>
          <h3 class="text-lg font-bold mb-2">General Freight</h3>
          <p class="text-steel text-sm leading-relaxed">Reliable general freight hauling across Montana and interstate. DOT certified and fully insured.</p>
        </div>
      </div>
      <div class="text-center mt-10">
        <a href={`${import.meta.env.BASE_URL}/services`} class="inline-flex items-center gap-2 text-brand font-semibold hover:text-brand-dark transition-colors">
          View All Services
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- About Snippet -->
  <section class="py-16 md:py-24 bg-cream-dark">
    <div class="max-w-6xl mx-auto px-4">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
        <div>
          <p class="text-brand uppercase tracking-widest text-sm font-semibold mb-2">About Us</p>
          <h2 class="text-3xl md:text-4xl font-bold mb-6">Built From the Ground Up</h2>
          <p class="text-steel-dark leading-relaxed mb-4">
            McCuen Construction & Trucking started in 2021 with a single side dump and a three-axle truck. Through hard work and a commitment to doing things right, we've grown to run 11 axle setups serving Billings and the surrounding area.
          </p>
          <p class="text-steel-dark leading-relaxed mb-6">
            We're a local, family-owned company that takes pride in dependable service. When you call us, you talk to real people who care about getting your job done on time and on budget.
          </p>
          <a href={`${import.meta.env.BASE_URL}/about`} class="inline-flex items-center gap-2 text-brand font-semibold hover:text-brand-dark transition-colors">
            Learn More About Us
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
            </svg>
          </a>
        </div>
        <!-- Placeholder for photo -->
        <div class="bg-steel/20 rounded-lg aspect-[4/3] flex items-center justify-center">
          <div class="text-center text-steel p-6">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16 mx-auto mb-3 opacity-40" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
            <p class="text-sm italic">Add photo: trucks on jobsite or Montana landscape</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Trust Signals -->
  <section class="py-12 bg-navy text-cream">
    <div class="max-w-6xl mx-auto px-4">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
        <div>
          <div class="text-3xl md:text-4xl font-bold text-accent mb-1">DOT</div>
          <p class="text-steel-light text-sm">Certified #3684397</p>
        </div>
        <div>
          <div class="text-3xl md:text-4xl font-bold text-accent mb-1">$1M</div>
          <p class="text-steel-light text-sm">Fully Insured</p>
        </div>
        <div>
          <div class="text-3xl md:text-4xl font-bold text-accent mb-1">2021</div>
          <p class="text-steel-light text-sm">Established</p>
        </div>
        <div>
          <div class="text-3xl md:text-4xl font-bold text-accent mb-1">Local</div>
          <p class="text-steel-light text-sm">Family-Owned & Operated</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-16 md:py-24">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <h2 class="text-3xl md:text-4xl font-bold mb-4">Ready to Get Your Project Moving?</h2>
      <p class="text-steel-dark text-lg mb-8 max-w-2xl mx-auto">
        Whether you need gravel hauled, a site excavated, or materials delivered, give us a call. We'll give you a straight answer and a fair price.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="tel:+14069452426" class="inline-flex items-center justify-center gap-2 bg-brand text-white px-8 py-4 rounded font-bold text-lg hover:bg-brand-light transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
            <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z" />
          </svg>
          Call (406) 945-2426
        </a>
        <a href={`${import.meta.env.BASE_URL}/contact`} class="inline-flex items-center justify-center gap-2 border-2 border-navy text-navy px-8 py-4 rounded font-bold text-lg hover:bg-navy hover:text-cream transition-colors">
          Send Us a Message
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
